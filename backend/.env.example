# Application Settings
APP_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key-in-production
API_PREFIX=/api/v1
DEBUG=true

# Database
DATABASE_URL=sqlite:///./data/portal.db

# Multi-database split (optional — defaults to DATABASE_URL when empty)
# ANALYTICS_DATABASE_URL=sqlite:///./data/analytics.db
# CHAT_DATABASE_URL=sqlite:///./data/chat.db

# Security
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Storage (S3) - Set S3_ENABLED=true to use S3
S3_ENABLED=false
S3_BUCKET=document-portal
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Email (SMTP) - Set EMAIL_ENABLED=true to use email
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@portal.com
EMAIL_FROM_NAME=Document Portal

# File Upload
MAX_UPLOAD_SIZE=10485760
