# =============================================================================
# Document Portal V2 - Production Environment Variables
# =============================================================================
# Copy this file to .env and update values for your environment
# Usage: docker-compose -f docker-compose.prod.yml --env-file .env up -d
# =============================================================================

# =============================================================================
# SECURITY (REQUIRED)
# =============================================================================
# Generate a secure random key: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production

# =============================================================================
# DATABASE
# =============================================================================
# SQLite (default) - path relative to container
DATABASE_URL=sqlite:///./data/portal.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://user:password@host:5432/portal

# =============================================================================
# REAL-TIME COLLABORATION
# =============================================================================
# WebSocket URL for the collaboration server (used by frontend)
COLLAB_WS_URL=wss://collab.portal.example.com

# Redis for horizontal scaling of collaboration (optional)
# Leave empty for single-server mode
REDIS_URL=

# To enable Redis: REDIS_URL=redis://redis:6379
# Then run: docker-compose -f docker-compose.prod.yml --profile with-redis up -d

# =============================================================================
# EMAIL CONFIGURATION (OPTIONAL)
# =============================================================================
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@portal.example.com

# =============================================================================
# S3 STORAGE (OPTIONAL)
# =============================================================================
S3_ENABLED=false
S3_BUCKET=document-portal
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# =============================================================================
# CORS & URLS
# =============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=["https://portal.example.com"]

# Frontend build-time variables
VITE_API_URL=https://api.portal.example.com
VITE_COLLAB_WS_URL=wss://collab.portal.example.com

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
