# =============================================================================
# Document Portal V2 - Production Environment Variables
# =============================================================================
# Copy this file to .env and update values for your environment
# Usage: docker-compose -f docker-compose.prod.yml --env-file .env up -d
# =============================================================================

# =============================================================================
# SECURITY (REQUIRED)
# =============================================================================
# Generate a secure random key: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production
# Optional 24h rotation grace key. Keep empty unless you are actively rotating.
SECRET_KEY_OLD=

# =============================================================================
# DATABASE
# =============================================================================
# SQLite (default) - path relative to container
DATABASE_URL=sqlite:///./data/portal.db

# Multi-database split (optional — defaults to DATABASE_URL when empty)
# Set these to separate analytics and chat into their own databases:
ANALYTICS_DATABASE_URL=sqlite:///./data/analytics.db
CHAT_DATABASE_URL=sqlite:///./data/chat.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://user:password@host:5432/portal
# ANALYTICS_DATABASE_URL=postgresql://user:password@host:5432/portal_analytics
# CHAT_DATABASE_URL=postgresql://user:password@host:5432/portal_chat

# =============================================================================
# REAL-TIME COLLABORATION
# =============================================================================
# Collaboration server URL used by backend-generated links or diagnostics
COLLAB_SERVER_URL=http://collab-server:8002

# Redis is required in production when RATE_LIMIT_ENABLED=true.
# The production compose file defaults to the bundled redis service.
REDIS_URL=redis://redis:6379/0

# Search backend must be explicit in production.
# Use sqlite_fts5 for SQLite, postgres_tsv for PostgreSQL, or portable_like for a DB-agnostic fallback.
SEARCH_BACKEND_MODE=portable_like

# Frontend build-time collaboration URL
VITE_COLLAB_SERVER_URL=wss://collab.portal.example.com

# Demo/test data seeding
# Development/test auto-seeds when unset. Production/staging require explicit true.
SEED_DEMO_DATA=false

# =============================================================================
# EMAIL CONFIGURATION (OPTIONAL)
# =============================================================================
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@portal.example.com

# =============================================================================
# S3 STORAGE (OPTIONAL)
# =============================================================================
S3_ENABLED=false
S3_BUCKET=document-portal
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# =============================================================================
# CORS & URLS
# =============================================================================
# JSON array of allowed origins. In development, include both localhost and 127.0.0.1.
CORS_ORIGINS=["https://portal.example.com"]

# Frontend build-time variables
VITE_API_URL=https://api.portal.example.com

# =============================================================================
# ASSISTANT CAPACITY (OPTIONAL)
# =============================================================================
# Global assistant chat bulkhead
ASSISTANT_CHAT_MAX_CONCURRENT=4
ASSISTANT_CHAT_MAX_QUEUE=8
ASSISTANT_CHAT_QUEUE_TIMEOUT_SECONDS=15

# Separate embedding bulkhead so routing/RAG work cannot starve chat entirely
ASSISTANT_EMBEDDING_MAX_CONCURRENT=4
ASSISTANT_EMBEDDING_MAX_QUEUE=16
ASSISTANT_EMBEDDING_QUEUE_TIMEOUT_SECONDS=10

# =============================================================================
# COLLABORATION RUNTIME GUARDRAILS (OPTIONAL)
# =============================================================================
COLLAB_MAX_TOTAL_CONNECTIONS=200
COLLAB_MAX_CONNECTIONS_PER_DOCUMENT=25
COLLAB_RECONNECT_WINDOW_SECONDS=60

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# =============================================================================
# DOCUMENT / CONVERSION BOUNDARIES
# =============================================================================
# Current production tier allows uploads up to 50MB and pushes reader
# artifact generation onto the durable conversion queue rather than per-request threads.
MAX_UPLOAD_SIZE=52428800

# =============================================================================
# FEATURE FLAGS (ROLLOUT / ROLLBACK SAFETY)
# =============================================================================
# Backend architecture toggles
FEATURE_FLAG_PROJECTION_CACHE=true
FEATURE_FLAG_IDEMPOTENCY_MIDDLEWARE=true
FEATURE_FLAG_EVENT_SOURCING_REVIEW_PILOT=false

# Frontend architecture toggles
VITE_FF_OPTIMISTIC_CONCURRENCY_HEADERS=true

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
