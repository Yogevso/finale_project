# Hocuspocus Collaboration Server Configuration

# =============================================================================
# SERVER
# =============================================================================
PORT=8002
HOST=0.0.0.0

# =============================================================================
# SECURITY
# =============================================================================
# Shared signing secret - MUST match FastAPI backend SECRET_KEY
SECRET_KEY=your-secret-key-change-in-production
# Optional 24h rotation grace key - set this only while rotating from an older SECRET_KEY
SECRET_KEY_OLD=
# Legacy fallback only: JWT_SECRET is still accepted if SECRET_KEY is unset

# =============================================================================
# BACKEND CONNECTION
# =============================================================================
# FastAPI backend URL for document persistence
# In Docker: http://backend:8000
# Local dev: http://localhost:8000
BACKEND_URL=http://localhost:8000
# FastAPI API prefix for persistence routes
BACKEND_API_PREFIX=/api/v1

# =============================================================================
# LOGGING
# =============================================================================
# Options: debug, info, warn, error
LOG_LEVEL=info

# =============================================================================
# REDIS (OPTIONAL - for horizontal scaling)
# =============================================================================
# Leave empty for single-server mode
# For scaling: redis://localhost:6379 or redis://redis:6379 in Docker
REDIS_URL=

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
# Debounce saves (ms) - reduce backend calls
DEBOUNCE_MS=2000
MAX_DEBOUNCE_MS=10000

# Connection guardrails
COLLAB_MAX_TOTAL_CONNECTIONS=200
COLLAB_MAX_CONNECTIONS_PER_DOCUMENT=25
COLLAB_RECONNECT_WINDOW_SECONDS=60
