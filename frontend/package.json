{
  "name": "document-portal-v2-frontend",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate:api-contracts:check && tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 50",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "npm run generate:api-contracts:check && vitest",
    "test:audience-smoke": "cd ../backend && if not exist temp mkdir temp && set APP_ENV=testing&& set SECRET_KEY=test-secret-key&& set DATABASE_URL=sqlite:///./temp/audience-smoke.db&& python -m pytest tests/scenarios/audience_smoke.py -x -q --tb=short --basetemp=\"temp/pytest\"",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "generate:api-contracts": "node ../scripts/api_contracts/generate_frontend_contracts.mjs",
    "generate:api-contracts:check": "node ../scripts/api_contracts/generate_frontend_contracts.mjs --check",
    "refresh:api-contracts": "node ../scripts/api_contracts/refresh_openapi_snapshot.mjs && npm run generate:api-contracts"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@hocuspocus/provider": "^3.4.3",
    "@tanstack/react-query": "^5.17.19",
    "@tiptap/extension-collaboration": "^3.16.0",
    "@tiptap/extension-collaboration-cursor": "^3.0.0",
    "@tiptap/extension-color": "^3.15.3",
    "@tiptap/extension-table": "^3.19.0",
    "@tiptap/extension-table-cell": "^3.19.0",
    "@tiptap/extension-table-header": "^3.19.0",
    "@tiptap/extension-table-row": "^3.19.0",
    "@tiptap/extension-text-align": "^3.15.3",
    "@tiptap/extension-text-style": "^3.15.3",
    "@tiptap/extension-underline": "^3.15.3",
    "@tiptap/react": "^3.15.3",
    "@tiptap/starter-kit": "^3.15.3",
    "@tiptap/y-tiptap": "^3.0.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "axios": "^1.6.5",
    "date-fns": "^3.2.0",
    "emoji-mart": "^5.6.0",
    "html-react-parser": "^5.2.17",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.11.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-joyride": "^2.9.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.21.3",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "y-indexeddb": "^9.0.12",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.29",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.41.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.2.1",
    "@vitest/ui": "^1.2.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.33",
    "prettier": "^3.2.4",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vitest": "^1.2.1"
  }
}
