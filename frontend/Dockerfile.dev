FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install --legacy-peer-deps

# Copy source
COPY . .

# Ensure local script can run in container
RUN chmod +x /app/docker-entrypoint.sh

# Expose port
EXPOSE 3000

# Run dev server
CMD ["/app/docker-entrypoint.sh"]
